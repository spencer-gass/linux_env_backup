# Define Variables
CC = gcc
CFLAGS = -Wall

# Targets that are not files
# even if a file named main exists, the phony target main will still build
.PHONY: all clean main

# make will build the first target in the make file if one isn't passed as an argument
all: main

# phony target that depends on a source file
# and calls GCC to compile
main: main.c
	$(CC) $(CFLAGS) -o main main.c

clean:
	rm -f main

hello:
	@echo "Hello World"
